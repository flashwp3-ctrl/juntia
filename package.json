{
  "name": "juntia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "next build",
    "start": "node scripts/next.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project=domain",
    "test:components": "vitest run --project=components",
    "test:a11y": "playwright test --project=a11y",
    "test:e2e:smoke": "playwright test --project=e2e",
    "check:internal-surface": "node scripts/check-internal-surface.mjs",
    "check:theme-script": "node scripts/check-theme-script.mjs",
    "verify": "node scripts/verify.mjs",
    "test:db": "supabase test db",
    "test:integration": "vitest run --project=integration --project=integration-deletion",
    "db:types:check": "node scripts/check-db-types.mjs",
    "db:restore-drill": "bash scripts/restore-drill.sh",
    "db:dev:reset": "node scripts/dev-target/run.mjs reset",
    "test:db:dev": "node scripts/dev-target/run.mjs test:db",
    "test:integration:dev": "node scripts/dev-target/run.mjs test:integration",
    "e2e:dev": "node scripts/dev-target/run.mjs e2e",
    "dev:unlock": "node scripts/dev-target/unlock.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "motion": "14.9.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/css": "1.4.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
