{
  "name": "juntia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project domain --passWithNoTests",
    "test:components": "vitest run --project components",
    "test:a11y": "playwright test --project a11y",
    "check:internal-surface": "node scripts/check-internal-surface.mjs",
    "check:theme-script": "node scripts/check-theme-script.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "motion": "14.9.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tailwindcss": "4.3.4",
    "@tailwindcss/postcss": "4.3.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "@eslint/css": "1.4.0",
    "vitest": "5.1.0",
    "vite": "8.3.5",
    "jsdom": "30.1.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
