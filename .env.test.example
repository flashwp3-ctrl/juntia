# Plantilla de .env.test para los comandos *:dev (maestro §15.10, decisión 18; ADR-011 §9.9; docs/TESTING.md §2).
# Copia este archivo como .env.test en la raíz del clon principal (los worktrees lo encuentran allí) y rellénalo
# desde el panel de juntia-dev. .env.test está en .gitignore: nunca se versiona, nunca se pega en el chat.
#
# Solo juntia-dev (itfrhnadovezpahikuol). El guardia de scripts/dev-target/guard.mjs se niega a correr si el destino
# es otro proyecto o si el ref de producción aparece en cualquier variable. Ninguna clave de producción, nunca.
# Ninguna variable empieza por NEXT_PUBLIC_: la app no lee este archivo; solo los scripts de prueba y siembra.

# Project Settings › Data API (o la página de inicio del proyecto) › Project URL. Solo el origen, con https.
JUNTIA_DEV_SUPABASE_URL=

# Project Settings › API Keys › Publishable key (sb_publishable_…).
JUNTIA_DEV_PUBLISHABLE_KEY=

# Project Settings › API Keys › Secret keys (sb_secret_…). Una clave propia para las pruebas, con un nombre que lo
# diga, para poder revocarla sin tocar nada más. Solo la usan la siembra y las pruebas; nunca la app.
JUNTIA_DEV_SECRET_KEY=

# Botón Connect › Session pooler (puerto 5432), con la contraseña de la base sustituida y codificada para URL.
# La conexión directa (db.<ref>.supabase.co) también vale, pero solo funciona con IPv6. El pooler de transacción
# (6543) no sirve: el guardia lo rechaza.
JUNTIA_DEV_DB_URL=
